{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Preview-only Worker. Production stays on Netlify until the migration QA gate passes.
  "name": "awakening-eden-library-staging",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
